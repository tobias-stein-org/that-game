<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Settings/UI/RuntimeStyle.uss?fileID=7433441132597879392&amp;guid=61ba2f276762743f3bb797f383c21847&amp;type=3#RuntimeStyle" />
    <ui:VisualElement name="panel" class="tg-menu-panel" style="flex-grow: 1; background-color: rgb(0, 0, 0);">
        <ui:Label tabindex="-1" text="Game Over" display-tooltip-when-elided="false" enable-rich-text="false" style="color: rgb(255, 255, 255); align-self: auto; -unity-text-align: upper-center; font-size: 32px;" />
        <ui:VisualElement name="actions" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); justify-content: flex-end;">
            <ui:Button text="Continue" display-tooltip-when-elided="true" name="continue" class="tg-menu-button" />
            <ui:Button text="Quit" display-tooltip-when-elided="true" name="quit" class="tg-menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
