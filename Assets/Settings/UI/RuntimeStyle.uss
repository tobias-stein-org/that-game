TextElement {
    -unity-font-definition: resource('Fonts/Khronopix');
}

Label {
    -unity-font-definition: resource('Fonts/Khronopix');
}

Button {
    -unity-font-definition: resource('Fonts/Khronopix');
}

.tg-menu-button {
    font-size: 32px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(229, 229, 229);
}

.tg-menu-button:hover {
    scale: 1.1 1.1;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out-elastic;
}

.tg-menu-button:active {
    color: rgb(255, 255, 255);
}

.tg-menu-panel {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0.15);
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 32px;
}

.tg-loading-progressbar {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    color: rgba(255, 255, 255, 0);
}

.tg-loading-progressbar .unity-progress-bar__background {
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
}

.tg-loading-progressbar Label {
    -unity-font-style: bold;
    -unity-font-definition: resource('Fonts/KhronopixMono SDF');
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 2px;
    -unity-text-align: middle-left;
    translate: 0 2px;
}

.tg-dialog-panel {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    max-width: 600px;
}

.tg-dialog-title {
    -unity-font-style: bold;
    font-size: 22px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 8px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(0, 0, 0);
    overflow: hidden;
}

.tg-dialog-actions {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    justify-content: flex-end;
}

.tg-dialog-actions > Button {
    font-size: 20px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(77, 77, 77);
    padding-left: 20px;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.tg-dialog-actions > Button:hover {
    scale: 1.1 1.1;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out-elastic;
}

.tg-dialog-actions > Button:active {
    color: rgb(255, 255, 255);
}

.tg-dialog-content {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
    margin-bottom: 12px;
}

.tg-dialog-content-message {
    white-space: normal;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}
