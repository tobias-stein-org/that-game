<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="actions" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); align-self: flex-end; flex-direction: row; min-height: auto; height: 24px; margin-top: 6px; margin-bottom: 6px;">
        <ui:Button text="Edit View" display-tooltip-when-elided="true" name="editView" />
        <ui:Button text="Edit Controller" display-tooltip-when-elided="true" name="editController" />
        <ui:Button text="Delete View" display-tooltip-when-elided="true" name="delete" />
    </ui:VisualElement>
</ui:UXML>
