GridBackground {
    --grid-background-color: rgb(40, 40, 40);
    --line-color: rgba(193, 196, 192, 0.1);
    --thick-line-color: rgba(193, 196, 192, 0.1);
    --spacing: 15;
}

.panel-header {
    -unity-background-image-tint-color: rgb(53, 53, 53);
    background-color: rgb(40, 40, 40);
    padding-left: 4px;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-font-style: normal;
    color: rgb(196, 196, 196);
}
