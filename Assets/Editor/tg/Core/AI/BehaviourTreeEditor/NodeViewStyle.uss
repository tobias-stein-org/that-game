#node-border {
    background-color: rgb(62, 62, 62);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-color: rgb(26, 26, 26);
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
}

#input {
    align-items: center;
}

#output {
    align-items: center;
}

#selection-border {
    border-left-color: rgb(0, 140, 255);
    border-right-color: rgb(0, 140, 255);
    border-top-color: rgb(0, 140, 255);
    border-bottom-color: rgb(0, 140, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

:hover > #selection-border {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 140, 255, 0.7);
    border-right-color: rgba(0, 140, 255, 0.7);
    border-top-color: rgba(0, 140, 255, 0.7);
    border-bottom-color: rgba(0, 140, 255, 0.7);
}

:selected > #selection-border {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(0, 140, 255);
    border-right-color: rgb(0, 140, 255);
    border-top-color: rgb(0, 140, 255);
    border-bottom-color: rgb(0, 140, 255);
}

:hover:selected > #selection-border {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(0, 140, 255);
    border-right-color: rgb(0, 140, 255);
    border-top-color: rgb(0, 140, 255);
    border-bottom-color: rgb(0, 140, 255);
}

.node {
    min-width: 150px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 1;
}

#title {
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    font-size: 15px;
}

#subtitle {
    font-size: 10px;
    color: rgb(173, 173, 173);
}

#divider {
    min-height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}
